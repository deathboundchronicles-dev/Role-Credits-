name: 
on:
  workflow_dispatch:
  push:
    paths:
      - 'android/**'
      - '.github/workflows/android-apk.yml'
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Build installable Android test APK
        working-directory: android
        run: gradle --no-daemon :app:assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: Role_Credits_Android_v0.2.4.5_Test_APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
      - name: Restore official signing key (if configured)
        id: sign
        env:
          KEYSTORE_BASE64: ${{ secrets.RC_ANDROID_KEYSTORE_BASE64 }}
        run: |
          if [ -n "$KEYSTORE_BASE64" ]; then
            printf '%s' "$KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/rolecredits-signing.jks"
            echo "ready=true" >> "$GITHUB_OUTPUT"
          else
            echo "ready=false" >> "$GITHUB_OUTPUT"
          fi
      - name: Build updateable signed APK
        if: steps.sign.outputs.ready == 'true'
        working-directory: android
        env:
          RC_ANDROID_KEYSTORE_FILE: ${{ runner.temp }}/rolecredits-signing.jks
          RC_ANDROID_STORE_PASSWORD: ${{ secrets.RC_ANDROID_STORE_PASSWORD }}
          RC_ANDROID_KEY_ALIAS: ${{ secrets.RC_ANDROID_KEY_ALIAS }}
          RC_ANDROID_KEY_PASSWORD: ${{ secrets.RC_ANDROID_KEY_PASSWORD }}
        run: gradle --no-daemon :app:assembleRelease
      - name: Package official APK with updater-compatible name and SHA
        if: steps.sign.outputs.ready == 'true'
        run: |
          cp android/app/build/outputs/apk/release/app-release.apk Role_Credits_Android.apk
          sha256sum Role_Credits_Android.apk > Role_Credits_Android.sha256
      - uses: actions/upload-artifact@v4
        if: steps.sign.outputs.ready == 'true'
        with:
          name: Role_Credits_Android_v0.2.4.5_Signed_APK
          path: |
            Role_Credits_Android.apk
            Role_Credits_Android.sha256
          if-no-files-found: error
